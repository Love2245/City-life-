{
  "name": "urban-life",
  "private": true,
  "version": "1.49.8",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-game.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build --configLoader runner",
    "build:portable": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build --config vite.portable.config.ts --configLoader runner && node --max-old-space-size=4096 scripts/inline-portable-assets.mjs && node scripts/publish-portable.mjs",
    "check": "svelte-check --config ./svelte.check.config.js --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "version:sync": "node scripts/sync-version.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tauri-apps/cli": "2.11.4",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.1.2",
    "@types/three": "0.180.0",
    "@vitejs/plugin-legacy": "6.1.1",
    "jsdom": "30.0.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "terser": "5.51.2",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.4"
  }
}
