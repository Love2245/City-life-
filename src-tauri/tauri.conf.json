{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "都市生活",
  "version": "1.49.8",
  "identifier": "com.urbanlife.game",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build --configLoader runner",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "都市生活",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "android": {
      "versionCode": 1498002
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
